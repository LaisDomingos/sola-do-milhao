# Copie este arquivo para ".env" e preencha com os dados do seu projeto no Supabase
# (Project Settings > API Keys). Depois rode: node ferramentas/gerar-config.js

# URL do projeto, algo como https://abcdefgh.supabase.co
SUPABASE_URL=

# Chave PÚBLICA: "anon" (começa com eyJ...) ou "publishable" (começa com sb_publishable_...).
# NUNCA use a chave "service_role" ou "secret" aqui: ela iria parar no site e daria acesso total ao banco.
SUPABASE_ANON_KEY=
